---
import { formatPhoneDisplay, formatPhoneHref } from "../utils/phone";
import { mapUrl } from "../utils/map";
import { normalizeForSearch } from "../utils/search";

interface Props {
  name: string;
  address?: string;
  phone?: string;
  website?: string;
  description?: string;
  tags?: string[];
  needsVerification?: boolean;
  category?: string;
  location?: string;
}

const { name, address, phone, website, description, tags, needsVerification, category, location } = Astro.props;

const searchText = normalizeForSearch(
  [name, description, address, ...(tags ?? [])].filter(Boolean).join(" "),
);
---

<article
  class="place-card"
  data-search={searchText}
  data-category={category}
  data-location={location}
>
  <h3 class="place-card__name">{name}</h3>
  {description && <p class="place-card__description">{description}</p>}
  <ul class="place-card__meta">
    {address && (
      <li>
        <a href={mapUrl(address)} target="_blank" rel="noopener noreferrer">📍 {address}</a>
      </li>
    )}
    {phone && (
      <li>
        <a href={`tel:${formatPhoneHref(phone)}`}>📞 {formatPhoneDisplay(phone)}</a>
      </li>
    )}
    {website && (
      <li>
        <a href={website} target="_blank" rel="noopener noreferrer">🌐 Strona www</a>
      </li>
    )}
  </ul>
  {tags && tags.length > 0 && (
    <ul class="place-card__tags">
      {tags.map((tag) => <li class="place-card__tag">{tag}</li>)}
    </ul>
  )}
  {needsVerification && <p class="place-card__verification">do weryfikacji</p>}
</article>

<style>
  .place-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .place-card__name {
    font-size: 1.05rem;
  }

  .place-card__description {
    color: var(--color-text-muted);
  }

  .place-card__meta {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .place-card__meta a {
    text-decoration: none;
  }

  .place-card__meta a:hover {
    text-decoration: underline;
  }

  .place-card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .place-card__tag {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .place-card__verification {
    align-self: flex-start;
    font-size: 0.75rem;
    color: var(--color-warning-text);
    background: var(--color-warning-bg);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
</style>
