---
import { siteConfig } from "../config";
---

{siteConfig.reportFormUrl ? (
  <a class="report-button" href={siteConfig.reportFormUrl} target="_blank" rel="noopener noreferrer">
    Zgłoś miejsce / popraw dane
  </a>
) : siteConfig.facebookGroupUrl ? (
  <a class="report-button" href={siteConfig.facebookGroupUrl} target="_blank" rel="noopener noreferrer">
    Zgłoszenia przez grupę FB Księżanie
  </a>
) : null}

<style>
  .report-button {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    font-weight: 600;
  }

  .report-button:hover {
    opacity: 0.9;
  }
</style>
