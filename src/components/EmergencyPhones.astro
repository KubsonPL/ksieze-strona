---
import { getCollection } from "astro:content";

const emergencyNumbers = await getCollection("emergency");
---

<section class="emergency" aria-labelledby="emergency-heading">
  <h2 id="emergency-heading">☎️ Ważne telefony</h2>
  <ul class="emergency__list">
    {emergencyNumbers.map(({ data }) => (
      <li>
        <span class="emergency__label">{data.label}</span>
        {data.phones.length > 0 ? (
          <span class="emergency__numbers">
            {data.phones.map((p) => (
              <a href={`tel:${p.number.replace(/\D/g, "")}`}>
                {p.note && <span class="emergency__note">{p.note}</span>} {p.number}
              </a>
            ))}
          </span>
        ) : (
          <span class="emergency__missing">do uzupełnienia</span>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .emergency__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .emergency__list li {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .emergency__label {
    color: var(--color-text-muted);
  }

  .emergency__numbers {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
  }

  .emergency__note {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .emergency__missing {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
