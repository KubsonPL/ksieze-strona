---
import { siteConfig } from "../config";

const formattedDate = new Date(siteConfig.lastUpdated).toLocaleDateString("pl-PL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<footer class="site-footer">
  <div class="container">
    <p>
      Lista ma charakter informacyjny i społecznościowy — wpisy nie są płatne i nie stanowią reklamy.
    </p>
    {siteConfig.facebookGroupUrl && (
      <p>
        Dołącz do grupy <a href={siteConfig.facebookGroupUrl} target="_blank" rel="noopener noreferrer">Księżanie na Facebooku</a>.
      </p>
    )}
    <p class="site-footer__updated">Ostatnia aktualizacja danych: {formattedDate}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-5);
    padding: var(--space-4) 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    margin-bottom: var(--space-2);
  }

  .site-footer__updated {
    margin-bottom: 0;
  }
</style>
